# Copy to deploy/.env (docker compose) or /etc/tradebot/secrets.env (systemd).
# Never commit the copy. Any TRADEBOT_SECTION_KEY variable overrides the
# config file's section.key, so the same mechanism can pin, for example,
# TRADEBOT_LIVE_MODE=shadow on a host regardless of what the file says.
TRADEBOT_BINANCE_API_KEY=
TRADEBOT_BINANCE_API_SECRET=
# TRADEBOT_LIVE_MODE=shadow
