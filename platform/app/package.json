{
  "name": "clawdie-platform-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared web and Electron presentation for the read-only trading platform.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node server.mjs --preview",
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:preview": "electron desktop/main.cjs --preview",
    "package:review": "node scripts/package-desktop.mjs --review",
    "package:production": "node scripts/package-desktop.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "main": "desktop/main.cjs",
  "author": "Platform maintainers"
}
